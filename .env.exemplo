# Copie para .env e preencha. O .env nunca vai para o Git.

# Google PageSpeed (grátis): https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# Pinas Kit — integração de leads e prospects (ver integracoes/pinas-kit.md)
PINAS_KIT_URL=
PINAS_KIT_TOKEN=
# Formato de autenticação: bearer | header | query
PINAS_KIT_AUTH=bearer

# Referências: segundos de pausa entre páginas (não diminua — evita bloqueio)
REFERENCIAS_PAUSA=4

# Copie para .env e preencha. O .env nunca vai para o Git.

# Google PageSpeed (grátis): https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# Pinas Kit (ver integracoes/pinas-kit.md). Sem senha: só a chave pública (data-pk) de uma captação sua.
PINAS_KIT_CHAVE=
# Opcionais (já vêm com o padrão certo)
PINAS_KIT_API=https://qdpwawkeiyvggcfonfsa.supabase.co/functions/v1
PINAS_KIT_ORIGEM=https://pinaskit.vercel.app
# Alternativa: webhook genérico em vez da API do Pinas Kit
PINAS_KIT_URL=
PINAS_KIT_TOKEN=
PINAS_KIT_AUTH=bearer

# Seu WhatsApp (recebe os briefings dos clientes). Formato: 5519999999999
PINAS_WHATSAPP=
# Opcional: webhook do n8n para receber briefings
BRIEFING_WEBHOOK=

# Referências: segundos de pausa entre páginas (não diminua — evita bloqueio)
REFERENCIAS_PAUSA=4
